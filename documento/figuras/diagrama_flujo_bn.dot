// Diagrama de flujo del proceso completo, versión horizontal en blanco y negro.
// Generar:  dot -Tpdf diagrama_flujo_bn.dot -o diagrama_flujo_bn.pdf
//           dot -Tpng -Gdpi=200 diagrama_flujo_bn.dot -o diagrama_flujo_bn.png
// Símbolos de diagrama de flujo: paralelogramo = datos de entrada o salida,
// rectángulo = operación, rombo = decisión, rectángulo redondeado = inicio/fin.
// Cada bloque es una columna; los bloques avanzan de izquierda a derecha y,
// dentro de cada uno, las etapas de arriba hacia abajo.
digraph proceso_bn {
    graph [rankdir=TB, fontname="DejaVu Sans", fontsize=12, nodesep=0.30, ranksep=0.30,
           newrank=true, compound=true, splines=ortho, pad=0.2, bgcolor="white"];
    node  [shape=box, style="solid", color="black", fontcolor="black", fontname="DejaVu Sans",
           fontsize=9, penwidth=0.9, margin="0.10,0.05", width=2.2];
    edge  [color="black", arrowsize=0.6, penwidth=0.8];

    subgraph cluster_1 {
        label=<<B>1. Adquisición</B>>; style="solid"; color="black"; penwidth=0.8;
        a1 [shape=box, style="rounded", label=<81 mediciones EFM-2ω (.ibw)<BR/><FONT POINT-SIZE="8">1024 × 1024, 60 × 60 µm</FONT>>];
        a2 [shape=parallelogram, width=1.9, label=<Canal eléctrico<BR/><I>I</I><SUB>raw</SUB>>];
        a3 [shape=parallelogram, width=1.9, label=<Canal topográfico<BR/><I>T</I><SUB>raw</SUB>>];
        a1 -> a2;
        a2 -> a3 [style=invis];
        a1 -> a3;
    }

    subgraph cluster_2 {
        label=<<B>2. Preprocesamiento</B>>; style="solid"; color="black"; penwidth=0.8;
        b1 [label=<Corrección de crosstalk topográfico<BR/><FONT POINT-SIZE="8">→ <I>I</I><SUB>corr</SUB></FONT>>];
        b2 [label=<Filtro sal y pimienta 5 × 5<BR/><FONT POINT-SIZE="8">→ <I>I</I><SUB>syp</SUB></FONT>>];
        b3 [label=<Corrección de fondo por línea<BR/><FONT POINT-SIZE="8">→ <I>I</I><SUB>fondo</SUB></FONT>>];
        b4 [label=<Filtro de líneas horizontales 5 × 1<BR/><FONT POINT-SIZE="8">→ <I>I</I><SUB>clean</SUB></FONT>>];
        b5 [label=<Normalización P1–P99<BR/><FONT POINT-SIZE="8">→ <I>I</I><SUB>seg</SUB></FONT>>];
        b1 -> b2 -> b3 -> b4 -> b5;
    }

    subgraph cluster_3 {
        label=<<B>3. Binarización</B>>; style="solid"; color="black"; penwidth=0.8;
        c1 [width=1.0, label=<Local<BR/><I>M</I><SUB>L</SUB>>];
        c2 [width=1.0, label=<Regional<BR/><I>M</I><SUB>R</SUB>>];
        c3 [width=1.0, label=<Global<BR/><I>M</I><SUB>G</SUB>>];
        c4 [label=<Conjunción y área mínima<BR/><FONT POINT-SIZE="8"><I>M</I><SUB>L</SUB> ∧ <I>M</I><SUB>R</SUB> ∧ <I>M</I><SUB>G</SUB>, ≥ 50 px</FONT>>];
        c5 [shape=diamond, width=1.5, margin="0.02,0.02", label=<Cobertura<BR/>≥ 15 %>];
        c6 [width=1.2, label=<Respaldo<BR/><I>M</I><SUB>L</SUB>>];
        c7 [shape=parallelogram, width=1.6, label=<Máscara estricta<BR/><I>M</I><SUB>e</SUB>>];
        {rank=same; c1; c2; c3;}
        c1 -> c2 -> c3 [style=invis];
        c1 -> c4; c2 -> c4; c3 -> c4;
        c4 -> c5;
        {rank=same; c6; c7;}
        c5 -> c6 [xlabel="no ", fontsize=8];
        c5 -> c7 [xlabel=" sí", fontsize=8];
        c6 -> c7;
    }

    subgraph cluster_4 {
        label=<<B>4. Representaciones de trabajo</B>>; style="solid"; color="black"; penwidth=0.8;
        d1 [label=<Cierre morfológico, r = 3 px<BR/><FONT POINT-SIZE="8">→ <I>M</I><SUB>mor</SUB></FONT>>];
        d2 [label=<Esqueletización y poda<BR/><FONT POINT-SIZE="8">→ <I>S</I></FONT>>];
        d3 [label=<Reconstrucción del canal eléctrico<BR/><FONT POINT-SIZE="8"><I>I</I><SUB>raw</SUB> − <I>Î</I><SUB>T</SUB>, SyP, RLOESS → <I>I</I><SUB>B</SUB></FONT>>];
        d1 -> d2;
        d2 -> d3 [style=invis];
    }

    subgraph cluster_5 {
        label=<<B>5. Extracción de descriptores</B><BR/><FONT POINT-SIZE="9">tabla de 81 mediciones × 20 descriptores</FONT>>; style="solid"; color="black"; penwidth=0.8;
        node [width=1.7];
        e1 [label=<Distribución espacial<BR/><FONT POINT-SIZE="8"><I>M</I><SUB>mor</SUB></FONT>>];
        e2 [label=<Orientación<BR/><FONT POINT-SIZE="8"><I>M</I><SUB>mor</SUB></FONT>>];
        e3 [label=<Forma<BR/><FONT POINT-SIZE="8"><I>M</I><SUB>mor</SUB>, <I>S</I></FONT>>];
        e4 [label=<Conectividad<BR/><FONT POINT-SIZE="8"><I>M</I><SUB>e</SUB>, <I>M</I><SUB>mor</SUB>, <I>S</I></FONT>>];
        e5 [label=<Intensidad<BR/><FONT POINT-SIZE="8"><I>I</I><SUB>B</SUB>, <I>M</I><SUB>e</SUB></FONT>>];
        e6 [label=<Perfil<BR/><FONT POINT-SIZE="8"><I>I</I><SUB>B</SUB></FONT>>];
        {rank=same; e1; e2;}
        {rank=same; e3; e4;}
        {rank=same; e5; e6;}
        e1 -> e2 [style=invis];  e3 -> e4 [style=invis];  e5 -> e6 [style=invis];
        e1 -> e3 [style=invis];  e3 -> e5 [style=invis];
    }

    subgraph cluster_6 {
        label=<<B>6. Análisis</B>>; style="solid"; color="black"; penwidth=0.8;
        f1 [label=<Análisis exploratorio<BR/><FONT POINT-SIZE="8">correlación, agrupamiento, PCA</FONT>>];
        f2 [label=<Modelos interpretables<BR/><FONT POINT-SIZE="8">descriptores → SE</FONT>>];
        f3 [label=<Importancia de descriptores>];
        f4 [shape=box, style="rounded", label=<Interpretación física>];
        f1 -> f2 -> f3 -> f4;
    }

    // Conexiones entre bloques (horizontales, por la fila superior)
    {rank=same; a1; b1; c1; d1; e1; f1;}
    a1 -> b1 [ltail=cluster_1, lhead=cluster_2];
    b1 -> c1 [ltail=cluster_2, lhead=cluster_3];
    c3 -> d1 [ltail=cluster_3, lhead=cluster_4];
    d1 -> e1 [ltail=cluster_4, lhead=cluster_5];
    e2 -> f1 [ltail=cluster_5, lhead=cluster_6];
}
