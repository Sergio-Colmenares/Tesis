// Diagrama de flujo del proceso completo, versión horizontal en blanco y negro.
// Generar:  dot -Tpdf diagrama_flujo_bn.dot -o diagrama_flujo_bn.pdf
//           dot -Tpng -Gdpi=200 diagrama_flujo_bn.dot -o diagrama_flujo_bn.png
// Cada bloque es una columna; los bloques avanzan de izquierda a derecha y, dentro de cada uno, las etapas de arriba hacia abajo.
digraph proceso_bn {
    graph [rankdir=TB, fontname="DejaVu Sans", fontsize=12, nodesep=0.35, ranksep=0.28,
           newrank=true, compound=true, splines=ortho, pad=0.2, bgcolor="white"];
    node  [shape=box, style="rounded", color="black", fontcolor="black", fontname="DejaVu Sans",
           fontsize=9, penwidth=0.9, margin="0.10,0.05", width=2.3];
    edge  [color="black", arrowsize=0.6, penwidth=0.8];

    // ------------------------------------------------------------------
    subgraph cluster_1 {
        label=<<B>1. Datos</B>>; style="rounded"; color="black"; penwidth=0.8;
        a1 [label=<81 mediciones EFM-2ω<BR/><FONT POINT-SIZE="8">9 condiciones × 3 réplicas × 3 posiciones<BR/>matrices de 1024 × 1024 (60 × 60 µm)</FONT>>];
        a2 [label=<Canal eléctrico <I>I</I><SUB>raw</SUB><BR/><FONT POINT-SIZE="8">señal ∝ ∂C/∂z, unidades nominales</FONT>>];
        a3 [label=<Canal topográfico <I>T</I><SUB>raw</SUB><BR/><FONT POINT-SIZE="8">altura de la superficie</FONT>>];
        {rank=same; a2; a3;}
        a1 -> a2; a1 -> a3;
    }

    // ------------------------------------------------------------------
    subgraph cluster_2 {
        label=<<B>2. Limpieza del canal eléctrico</B>>; style="rounded"; color="black"; penwidth=0.8;
        b1 [label=<Quitar la huella de la topografía<BR/><FONT POINT-SIZE="8">ajuste lineal global (crosstalk) → <I>I</I><SUB>corr</SUB></FONT>>];
        b2 [label=<Quitar puntos aislados<BR/><FONT POINT-SIZE="8">mediana selectiva 5 × 5 → <I>I</I><SUB>syp</SUB></FONT>>];
        b3 [label=<Igualar el nivel de cada línea<BR/><FONT POINT-SIZE="8">resta del fondo por fila → <I>I</I><SUB>fondo</SUB></FONT>>];
        b4 [label=<Quitar líneas sueltas<BR/><FONT POINT-SIZE="8">mediana selectiva vertical 5 × 1 → <I>I</I><SUB>clean</SUB></FONT>>];
        b5 [label=<Escalar a [0, 1]<BR/><FONT POINT-SIZE="8">percentiles 1 y 99 → <I>I</I><SUB>seg</SUB></FONT>>, penwidth=1.6];
        b1 -> b2 -> b3 -> b4 -> b5;
    }

    // ------------------------------------------------------------------
    subgraph cluster_3 {
        label=<<B>3. Separación red / fondo</B>>; style="rounded"; color="black"; penwidth=0.8;
        c1 [width=1.2, label=<Umbral local<BR/><FONT POINT-SIZE="8">vecindad σ = 21 px → <I>M</I><SUB>L</SUB></FONT>>];
        c2 [width=1.2, label=<Umbral regional<BR/><FONT POINT-SIZE="8">vecindad σ = 51 px → <I>M</I><SUB>R</SUB></FONT>>];
        c3 [width=1.2, label=<Umbral global<BR/><FONT POINT-SIZE="8">Otsu multinivel → <I>M</I><SUB>G</SUB></FONT>>];
        c4 [label=<Coincidencia de los tres<BR/><FONT POINT-SIZE="8">y retiro de manchas &lt; 50 px</FONT>>];
        c5 [label=<¿Cubre ≥ 15 %?>, shape=diamond, style="", width=1.6, margin="0.02,0.02"];
        c6 [label=<Respaldo: solo umbral local>, style="rounded,dashed"];
        c7 [label=<Máscara de la red <I>M</I><SUB>e</SUB>>, penwidth=1.6];
        {rank=same; c1; c2; c3;}
        c1 -> c2 -> c3 [style=invis];
        c1 -> c4; c2 -> c4; c3 -> c4;
        c4 -> c5;
        {rank=same; c6; c7;}
        c5 -> c7 [xlabel="sí", fontsize=8];
        c5 -> c6 [xlabel="no", fontsize=8];
        c6 -> c7;
    }

    // ------------------------------------------------------------------
    subgraph cluster_4 {
        label=<<B>4. Representaciones</B>>; style="rounded"; color="black"; penwidth=0.8;
        d1 [label=<Unir cortes cercanos<BR/><FONT POINT-SIZE="8">cierre con disco r = 3 px → <I>M</I><SUB>mor</SUB></FONT>>];
        d2 [label=<Esqueleto de la red<BR/><FONT POINT-SIZE="8">líneas de 1 px, poda de 5 px → <I>S</I></FONT>>];
        d3 [label=<Imagen eléctrica en escala original<BR/><FONT POINT-SIZE="8">sin crosstalk (ajuste de la etapa 2) ni rayas → <I>I</I><SUB>B</SUB></FONT>>];
        d1 -> d2;
        d2 -> d3 [style=invis];
    }

    // ------------------------------------------------------------------
    subgraph cluster_5 {
        label=<<B>5. Descriptores (20)</B>>; style="rounded"; color="black"; penwidth=0.8;
        e1 [label=<Distribución espacial<BR/><FONT POINT-SIZE="8">CNTD, CNTA, CNTS · usa <I>M</I><SUB>mor</SUB></FONT>>];
        e2 [label=<Orientación<BR/><FONT POINT-SIZE="8">ángulo dominante, coherencia · usa <I>M</I><SUB>mor</SUB></FONT>>];
        e3 [label=<Forma<BR/><FONT POINT-SIZE="8">área, elongación, tortuosidad · usa <I>M</I><SUB>mor</SUB>, <I>S</I></FONT>>];
        e4 [label=<Conectividad<BR/><FONT POINT-SIZE="8">cobertura, percolación, longitud, fragmentos<BR/>usa <I>M</I><SUB>e</SUB>, <I>M</I><SUB>mor</SUB>, <I>S</I></FONT>>];
        e5 [label=<Intensidad<BR/><FONT POINT-SIZE="8">media, desviación, P90, gradiente · usa <I>I</I><SUB>B</SUB> en <I>M</I><SUB>e</SUB></FONT>>];
        e6 [label=<Perfil vertical<BR/><FONT POINT-SIZE="8">pendiente, residuo, rango · usa <I>I</I><SUB>B</SUB></FONT>>];
        e1 -> e2 -> e3 -> e4 -> e5 -> e6 [style=invis];
    }

    // ------------------------------------------------------------------
    subgraph cluster_6 {
        label=<<B>6. Análisis</B>>; style="rounded"; color="black"; penwidth=0.8;
        f1 [label=<Tabla de descriptores<BR/><FONT POINT-SIZE="8">81 mediciones × 20 descriptores</FONT>>];
        f2 [label=<Exploración<BR/><FONT POINT-SIZE="8">correlaciones, agrupamiento, PCA</FONT>>];
        f3 [label=<Modelos interpretables<BR/><FONT POINT-SIZE="8">descriptores → apantallamiento (SE)</FONT>>];
        f4 [label=<Interpretación física<BR/><FONT POINT-SIZE="8">morfología de la red ↔ SE</FONT>>, penwidth=1.6];
        f1 -> f2 -> f3 -> f4;
    }

    // ------------------------------------------------------------------
    // Conexiones entre bloques
    {rank=same; a1; b1; c1; d1; e1; f1;}
    a1 -> b1 [ltail=cluster_1, lhead=cluster_2];
    b1 -> c1 [ltail=cluster_2, lhead=cluster_3];
    c3 -> d1 [ltail=cluster_3, lhead=cluster_4];
    d1 -> e1 [ltail=cluster_4, lhead=cluster_5];
    e1 -> f1 [ltail=cluster_5, lhead=cluster_6];
}
